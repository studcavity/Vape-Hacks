# Host-specific / generated; never commit
.venv/
venv/
__pycache__/
*.pyc

# Build output (arduino-cli --output-dir, PlatformIO)
build/
.pio/

# Editor
.vscode/
.idea/

# Local state for tools/lb_flash.py (per-machine canary record)
.lb_canary.json

# arduino-cli / Arduino data if a sandbox ever puts it in the tree
.arduino15/

# Compiled firmware outputs from our own sketches (regenerable). Device dumps
# such as backup_flash.bin are NOT matched by these patterns.
*.ino.elf
*.ino.hex
*.ino.map
